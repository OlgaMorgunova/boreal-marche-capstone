# Copy to .env (git-ignored) and fill locally. Never commit real secrets.

# Application
APP_ENV=local
LOG_LEVEL=INFO
# registry = resolve models:/boreal-retention@champion first; local = artifacts/model.joblib only
BOREAL_MODEL_SOURCE=registry
# Repository root override (containers/tests); leave empty locally
BOREAL_ROOT=
# Commit reported by /version in containers (CD sets it to the image's commit SHA)
GIT_SHA=

# MLflow (default: SQLite file in the repo, see params.yaml)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Database for prediction logging (D4)
DATABASE_URL=sqlite:///./boreal.db

# LLM providers for Head C (Week 9-10) — no personal data may be sent to hosted providers
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Hyper-parameter search backend: local | aws | azure  (python -m boreal_marche.cloud)
HPO_PROVIDER=local

# AWS SageMaker (course default; prefer `aws sso login` / an assumed role over access keys)
AWS_REGION=ca-central-1
SAGEMAKER_ROLE_ARN=
SAGEMAKER_BUCKET=

# Azure Machine Learning (alternative; authenticate with `az login` — DefaultAzureCredential)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZUREML_WORKSPACE=
