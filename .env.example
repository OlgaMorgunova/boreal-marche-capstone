# Copy to .env (git-ignored) and fill locally. Never commit real secrets.

# Application
APP_ENV=local
LOG_LEVEL=INFO
# registry = resolve models:/boreal-retention@champion first; local = artifacts/model.joblib only
BOREAL_MODEL_SOURCE=registry
# Repository root override (containers/tests); leave empty locally
BOREAL_ROOT=
# Commit reported by /version in containers (CD sets it to the image's commit SHA)
GIT_SHA=

# MLflow (default: SQLite file in the repo, see params.yaml)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Prediction / request log (D4). SQLite locally and on App Runner; Compose uses Postgres:
#   postgresql+psycopg://boreal:<password>@db:5432/boreal
DATABASE_URL=sqlite:///./boreal.db
# Base URL the assistant's tools use to call this same API (/predict, /recommend, /products)
BOREAL_API_URL=http://127.0.0.1:8000
# Background monitoring loop (1 = on); evaluation interval is params.yaml -> monitoring
BOREAL_MONITOR_LOOP=1
# Optional: Slack / Teams / Discord incoming webhook that receives monitoring alerts
ALERT_WEBHOOK_URL=
# Embedding model cache (the Docker image bakes the model into /opt/models)
BOREAL_EMBED_CACHE=.cache/fastembed

# Interface (Streamlit)
API_URL=http://127.0.0.1:8000
PUBLIC_API_URL=http://127.0.0.1:8000

# LLM providers for Head C — no personal data may be sent to hosted providers
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# Compose only: password of the local Postgres container
POSTGRES_PASSWORD=

# Hyper-parameter search backend: local | aws | azure  (python -m boreal_marche.cloud)
HPO_PROVIDER=local

# AWS SageMaker (course default; prefer `aws sso login` / an assumed role over access keys)
AWS_REGION=ca-central-1
SAGEMAKER_ROLE_ARN=
SAGEMAKER_BUCKET=

# Azure Machine Learning (alternative; authenticate with `az login` — DefaultAzureCredential)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZUREML_WORKSPACE=
