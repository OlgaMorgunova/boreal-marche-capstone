{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PushToTheTwoRepositoriesOnly",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:CompleteLayerUpload",
        "ecr:DescribeImages",
        "ecr:GetDownloadUrlForLayer",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": [
        "arn:aws:ecr:__REGION__:__ACCOUNT_ID__:repository/boreal-api",
        "arn:aws:ecr:__REGION__:__ACCOUNT_ID__:repository/boreal-ui"
      ]
    },
    {
      "Sid": "DeployTheTwoAppRunnerServicesOnly",
      "Effect": "Allow",
      "Action": [
        "apprunner:UpdateService",
        "apprunner:DescribeService",
        "apprunner:ListOperations"
      ],
      "Resource": [
        "arn:aws:apprunner:__REGION__:__ACCOUNT_ID__:service/boreal-api/*",
        "arn:aws:apprunner:__REGION__:__ACCOUNT_ID__:service/boreal-ui/*"
      ]
    },
    {
      "Sid": "LetAppRunnerPullFromEcr",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::__ACCOUNT_ID__:role/BorealAppRunnerEcrAccess"
    }
  ]
}
